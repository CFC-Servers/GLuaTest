# GLuaTest — env vars for running `docker compose` directly in this directory.
# All are OPTIONAL: every var has a safe default (see docker-compose.yml), and
# the run_local.sh wrapper sets all of these for you.
#
# To use: copy to `.env`, uncomment what you need. Do NOT commit your `.env`
# (it may hold credentials).

# GMod branch to test on: public, x86-64, prerelease, or dev
#GMOD_BRANCH=public

# Absolute path to a requirements file (one Owner/Repo per line)
#REQUIREMENTS=/absolute/path/to/gluatest_requirements.txt

# Absolute path to a server cfg appended to the test server's config
#CUSTOM_SERVER_CONFIG=/absolute/path/to/gluatest_custom.cfg

# Absolute path to a directory laid out like garrysmod/ (addons/, gamemodes/, lua/, ...)
# The server copies this over its own files before starting.
#PROJECT_DIR=/absolute/path/to/garrysmod_override

# Absolute path to a directory of extra artifacts to copy into the server root.
# The entrypoint reads from a _gluatest_artifacts/ subdirectory inside it.
# Default is this docker/ directory itself (that's what CI relies on).
#GMOD_ARTIFACT_DIR=/absolute/path/to/artifacts

# Test server settings (entrypoint defaults: sandbox / gm_construct / 2 / 0)
#GAMEMODE=sandbox
#MAP=gm_construct
#TIMEOUT=2
#COLLECTION_ID=

# Credentials for privately-hosted requirements
# https://github.com/CFC-Servers/GLuaTest/wiki/Private-Requirements
#SSH_PRIVATE_KEY=
#GITHUB_TOKEN=

# Extra srcds startup args
#EXTRA_STARTUP_ARGS=
